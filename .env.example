# Optional: without these, Hearth opens in demo mode.
HESTIA_URL=https://panel.example.com:8083
HESTIA_USER=your-hestia-user
HESTIA_ACCESS_KEY=
HESTIA_SECRET_KEY=
PORT=4317

# Real installs: explicitly enable after configuring your Hestia test server.
HEARTH_INSTALL_ENABLED=false
# IPv4 address assigned to websites in Hestia (direct DNS, no proxy).
HESTIA_SITE_IP=
# Installed PHP version supported by Hestia's WordPress installer.
HESTIA_PHP_VERSION=8.3
# Optional absolute path for private, non-secret installation progress records.
# HEARTH_DATA_DIR=/your/private/hearth-data
